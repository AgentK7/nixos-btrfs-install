# Grundwerte für alle Szenarien: Variablen so, wie sie nach den Abfragen im Installer stehen.
# Ja/Nein als 1/0. Die Szenarien überschreiben nur, was sie anders brauchen.
BOOT_MODE=uefi GRUB_DEV= INSTALL_MODE=wipe UKI=0 SB_ENROLL=0 XBOOT=0 WINDOWS=0 ESP_GB=1 COMPRESS=zstd
DISK2_MODE=none DATA_PART= DATA_FSTYPE= SWAP_GB=4 ZRAM=1
ENCRYPT=0 LUKS_UUID= LUKS2_UUID= TPM2=0 FIDO2_LUKS=0 SSH_UNLOCK=0 SSH_UNLOCK_MODS= NET_IF=
LAPTOP=0 HIBERNATE=0 RESUME_UUID= RESUME_OFFSET=0 LID=none CPU_INTEL=0 IS_VM=1 CHARGE_LIMIT=0 CHARGE_MAX=80
KERNEL=latest TUNING=1 SILENT=0 RESCUE=0 HW_PROFILE=none
GPU=amd NV_OPEN=0 IGPU_VENDOR= IGPU_DEV= NV_DEV=
DESKTOP=plasma DESKTOP_MODE=minimal FLATPAK=1 UNFREE=1 PRINTING=1 BLUETOOTH=1 FINGERPRINT=0
PRN_HP=0 PRN_BROTHER=0 PRN_EPSON=0 PRN_GUTENPRINT=0 PRN_FOO2ZJS=0 PRN_SPLIX=0
XKB_LAYOUT=de XKB_VARIANT= LANG_LOCALE=de_DE.UTF-8 FORMAT_LOCALE= TIMEZONE=Europe/Berlin
NIX_HOSTNAME=testpc NIX_USER=philipp EXTRA_USERS= LOGIN_SHELL=bash OHMYZSH=0 HOME_MANAGER=0 GIT_NAME= GIT_EMAIL=
SSHD=0 SSH_KEYS_NIX= FAIL2BAN=0 FIDO2_SUDO=0 U2F_LINE=
NET_MODE=dhcp NET_ADDR= NET_GW= NET_DNS= NET_ADDR6= NET_GW6= WIFI_COPY=0 LIVE_PROXY=
DNS_TLS=none DNS_TLS_SERVERS= WOL=0 CACHE_URL= CACHE_KEY=
VPN=none TAILSCALE=0 WG_CONF= WG_CONF_TEXT= TS_AUTHKEY=
SAMBA=none LIBVIRT=0 CONTAINERS=none SNAPPER=0 BACKUP=0 BACKUP_REPO= AUTOUPDATE=0
GAMING=0 RETROARCH=0 ANANICY=0
for e in "${GAME_ITEMS[@]}"; do printf -v "${e%%|*}" 0; done
SOFTWARE=0
for e in "${SW_CATS[@]}"; do printf -v "${e%%|*}" 0; done
for e in "${SW_APPS[@]}"; do IFS='|' read -r _ v _ <<<"$e"; printf -v "$v" 0; done

# Hilfen für Szenarien
alle_programme() {   # alle Programme aller Kategorien; mit "frei" nur freie
  local e c v f
  SOFTWARE=1
  for e in "${SW_CATS[@]}"; do printf -v "${e%%|*}" 1; done
  for e in "${SW_APPS[@]}"; do
    IFS='|' read -r c v _ f _ <<<"$e"
    if [[ ${1-} == frei && $f == *u* ]]; then printf -v "$v" 0; else printf -v "$v" 1; fi
  done
}
alle_spiele() {
  local e
  GAMING=1
  for e in "${GAME_ITEMS[@]}"; do printf -v "${e%%|*}" 1; done
}
