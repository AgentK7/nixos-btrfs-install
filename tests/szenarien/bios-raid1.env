# Legacy-BIOS mit GRUB, LUKS auf RAID1, feste IPv4/IPv6, WireGuard, Xfce, NVIDIA mit Treiber 580, LTS
BOOT_MODE=bios GRUB_DEV=/dev/sda ENCRYPT=1 LUKS_UUID=11111111-2222-3333-4444-555555555555 LUKS2_UUID=66666666-2222-3333-4444-555555555555
DISK2_MODE=raid1 SWAP_GB=0 SILENT=1 RESCUE=1 KERNEL=lts
NET_MODE=static NET_IF=eno1 NET_ADDR=192.168.10.20/24 NET_GW=192.168.10.1 NET_DNS="192.168.10.1 9.9.9.9"
NET_ADDR6=2001:db8::20/64 NET_GW6=2001:db8::1
VPN=wireguard WG_CONF=/tmp/wg0.conf
WG_CONF_TEXT=$'[Interface]\nPrivateKey = aGVsbG8gd29ybGQgaGVsbG8gd29ybGQgaGVsbG8gd28=\nAddress = 10.0.0.2/24\nListenPort = 51820'
CONTAINERS=podman DESKTOP=xfce GPU=nvidia NV_OPEN=0 SNAPPER=1 SAMBA=client
GAMING=1 STEAM=1 VR=alvr
