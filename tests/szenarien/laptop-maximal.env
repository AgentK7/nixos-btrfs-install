# GNOME-Laptop mit fast allem: UKI, TPM2, FIDO2, LUKS per SSH, NVIDIA-PRIME mit Hardware-Profil, home-manager
UKI=1 ENCRYPT=1 LUKS_UUID=11111111-2222-3333-4444-555555555555 TPM2=1 FIDO2_LUKS=1
SSH_UNLOCK=1 SSH_UNLOCK_MODS="e1000e r8169" NET_IF=enp0s31f6
SILENT=1 LAPTOP=1 HIBERNATE=1 RESUME_OFFSET=533760 LID=hibernate CPU_INTEL=1 CHARGE_LIMIT=1 CHARGE_MAX=80
SNAPPER=1 BACKUP=1 BACKUP_REPO=sftp:philipp@nas:/backup/testpc FINGERPRINT=1 FIDO2_SUDO=1
LOGIN_SHELL=zsh OHMYZSH=1 HOME_MANAGER=1 GIT_NAME=Philipp GIT_EMAIL=p@example.org
SSHD=1 FAIL2BAN=1 SSH_KEYS_NIX=$'\n      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGtestkey test"'
VPN=tailscale TAILSCALE=1 TS_AUTHKEY=tskey-test SAMBA=server LIBVIRT=1 CONTAINERS=docker AUTOUPDATE=1
GPU=nvidia-prime NV_OPEN=1 IGPU_VENDOR=intel IGPU_DEV=0000:00:02.0 NV_DEV=0000:01:00.0 HW_PROFILE=lenovo/thinkpad/t480
DESKTOP=gnome DESKTOP_MODE=full EXTRA_USERS=kind1 KERNEL=xanmod
DNS_TLS=quad9 DNS_TLS_SERVERS="9.9.9.9#dns.quad9.net 2620:fe::fe#dns.quad9.net"
PRN_HP=1 PRN_EPSON=1
GAMING=1 STEAM=1 ANANICY=1
