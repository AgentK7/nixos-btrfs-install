# Server ohne Desktop: feste IP, SSH, LUKS per SSH entsperren, Wake-on-LAN, Binär-Cache, DNS über TLS
DESKTOP=none DESKTOP_MODE=none GPU=generic FLATPAK=0 PRINTING=0 BLUETOOTH=0
NET_MODE=static NET_IF=eno1 NET_ADDR=10.0.0.5/24 NET_GW=10.0.0.1 NET_DNS=
SSHD=1 FAIL2BAN=1 SSH_KEYS_NIX=$'\n      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGtestkey test"'
ENCRYPT=1 LUKS_UUID=11111111-2222-3333-4444-555555555555 SSH_UNLOCK=1 SSH_UNLOCK_MODS=igb
AUTOUPDATE=1 CONTAINERS=docker WOL=1 KERNEL=lts
CACHE_URL=http://cache.schule.lan:5000 CACHE_KEY=cache.schule.lan-1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DNS_TLS=cloudflare DNS_TLS_SERVERS="1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com"
